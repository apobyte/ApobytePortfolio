---
import ThemeToggle from "./ThemeToggle";
import { site } from "../data/site";

const currentPath = Astro.url.pathname;

function isCurrent(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header panel" transition:persist="site-header">
  <span class="panel__corners" aria-hidden="true">
    <i></i><i></i><i></i><i></i>
  </span>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>
      <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8.2 6.4 16 14.2 23.8 6.4 25.6 8.2 17.8 16l7.8 7.8-1.8 1.8L16 17.8 8.2 25.6 6.4 23.8 14.2 16 6.4 8.2z"
        />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle client:load />
      <button
        type="button"
        class="nav-toggle"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  function isCurrent(href: string, path: string) {
    if (href === "/") return path === "/";
    return path === href || path.startsWith(`${href}/`);
  }

  function initHeader() {
    const headerEl = document.querySelector<HTMLElement>(".site-header");
    const toggleEl = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const navEl = document.querySelector<HTMLElement>("#site-nav");
    if (!headerEl || !toggleEl || !navEl) return;
    const header = headerEl;
    const toggle = toggleEl;
    const nav = navEl;

    function setOpen(open: boolean) {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      header.classList.toggle("is-nav-open", open);
      document.body.classList.toggle("is-nav-open", open);
    }

    function syncNav() {
      const path = window.location.pathname;
      nav.querySelectorAll("a").forEach((link) => {
        const href = new URL(link.href, window.location.origin).pathname;
        if (isCurrent(href, path)) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    if (header.dataset.navBound !== "true") {
      header.dataset.navBound = "true";
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        setOpen(open);
      });
      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
      window.matchMedia("(min-width: 961px)").addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
    }

    setOpen(false);
    syncNav();
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
