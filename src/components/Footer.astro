---
import SocialIcon from "./SocialIcon.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer panel" transition:persist="site-footer">
  <span class="panel__corners" aria-hidden="true">
    <i></i><i></i><i></i><i></i>
  </span>
  <div class="footer-inner">
    <a class="footer-brand" href="/contact">
      <p class="panel-kicker">Contact</p>
      <p class="panel-jp">コンタクト</p>
    </a>

    <div class="footer-contacts">
      <a class="contact-item" href={`mailto:${site.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            d="M4 6.5h16v11H4zM4.2 7.2 12 13l7.8-5.8"
          />
        </svg>
        <span>
          <b>Email</b>
          {site.email}
        </span>
      </a>
      <a class="contact-item" href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            d="M7.2 3.8h3.1l1.2 3-1.7 1.2a12 12 0 0 0 6.2 6.2l1.2-1.7 3 1.2v3.1c0 .7-.6 1.4-1.3 1.5A16.5 16.5 0 0 1 3.7 5.1c.1-.7.8-1.3 1.5-1.3z"
          />
        </svg>
        <span>
          <b>Phone</b>
          {site.phone}
        </span>
      </a>
      <p class="contact-item">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"
          />
          <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span>
          <b>Location</b>
          {site.location} 🌍
        </span>
      </p>
    </div>

    <div class="social-pill">
      {
        site.socials.map((item) => (
          <a href={item.href} aria-label={item.label} target="_blank" rel="noreferrer">
            <SocialIcon name={item.icon} />
          </a>
        ))
      }
    </div>
  </div>
  <p class="footer-copy">© {year} {site.name}. All rights reserved.</p>
</footer>
