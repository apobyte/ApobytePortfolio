---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import ContactForm from "../components/ContactForm";
import { site } from "../data/site";
---

<BaseLayout title="Contact" description={`Contact ${site.name}`}>
  <Panel class="page-hero">
    <p class="panel-jp">連絡先</p>
    <p class="panel-kicker">Contact</p>
    <h1>Let’s talk.</h1>
    <p class="lede">
      Email <a href={`mailto:${site.email}`}>{site.email}</a> or send a note below.
    </p>
  </Panel>

  <Panel class="section">
    <ContactForm client:load />
  </Panel>
</BaseLayout>
