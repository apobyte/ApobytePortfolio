---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section class="hero">
    <p class="kicker">404</p>
    <h1>Page not found.</h1>
    <p class="lede">That route is not here. Head back home and try again.</p>
    <div class="actions">
      <a class="button button-primary" href="/">Back home</a>
    </div>
  </section>
</BaseLayout>
