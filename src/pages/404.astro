---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
---

<BaseLayout title="Not found" description="This page does not exist.">
  <Panel class="page-hero">
    <p class="panel-jp">迷子</p>
    <p class="panel-kicker">404</p>
    <h1>Signal lost.</h1>
    <p class="lede">That route is not here. Head back home and try again.</p>
    <div class="actions">
      <a class="button button-cta" href="/">Back home</a>
    </div>
  </Panel>
</BaseLayout>
