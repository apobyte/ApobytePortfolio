---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import StackPact from "../components/StackPact.astro";
import SkillSigil from "../components/SkillSigil.astro";
import { boundPacts } from "../data/stacks";
import { site } from "../data/site";
import {
  skillSchools,
  skillSlug,
  skills,
  skillsInSchool,
} from "../data/skills";

const skySparkles = [
  { left: "8%", top: "18%", size: "7px", duration: "2.4s", delay: "0.1s" },
  { left: "22%", top: "8%", size: "10px", duration: "2.8s", delay: "0.6s" },
  { left: "78%", top: "12%", size: "6px", duration: "2.1s", delay: "1.1s" },
  { left: "91%", top: "38%", size: "8px", duration: "2.6s", delay: "0.3s" },
  { left: "14%", top: "72%", size: "9px", duration: "2.9s", delay: "1.7s" },
  { left: "86%", top: "78%", size: "7px", duration: "2.5s", delay: "0.4s" },
  { left: "48%", top: "6%", size: "5px", duration: "2.2s", delay: "1.4s" },
  { left: "52%", top: "92%", size: "6px", duration: "2.7s", delay: "0.8s" },
  { left: "34%", top: "16%", size: "4px", duration: "3.1s", delay: "0.9s" },
  { left: "64%", top: "20%", size: "5px", duration: "2.6s", delay: "1.8s" },
  { left: "18%", top: "46%", size: "6px", duration: "3.4s", delay: "0.2s" },
  { left: "80%", top: "58%", size: "4px", duration: "2.3s", delay: "1.3s" },
];

const skyOrder = ["HTML5", "OpenAI", "JavaScript", "TypeScript", "SAP", "Next.js", "Astro", "Tailwind CSS"];
const skySkills = skyOrder.flatMap((name) => {
  const skill = skills.find((entry) => entry.name === name);
  return skill ? [skill] : [];
});
const constellation = skySkills.map((skill, index) => {
  const angle = (index / skySkills.length) * Math.PI * 2 - Math.PI / 2;
  const radius = 38;
  const x = 50 + Math.cos(angle) * radius;
  const y = 50 + Math.sin(angle) * radius;
  const next = skySkills.length ? (index + 1) % skySkills.length : 0;
  return { skill, x, y, index, next };
});

const skyTicks = Array.from({ length: 36 }, (_, index) => {
  const angle = (index / 36) * Math.PI * 2 - Math.PI / 2;
  const major = index % 3 === 0;
  const inner = major ? 15.2 : 18.8;
  const outer = 21.5;
  return {
    x1: (50 + Math.cos(angle) * inner).toFixed(2),
    y1: (50 + Math.sin(angle) * inner).toFixed(2),
    x2: (50 + Math.cos(angle) * outer).toFixed(2),
    y2: (50 + Math.sin(angle) * outer).toFixed(2),
    major,
  };
});

const chapters = skillSchools
  .map((school) => ({ school, entries: skillsInSchool(school.id) }))
  .filter((chapter) => chapter.entries.length > 0);
---

<BaseLayout title="Skills" description={`The craft index of ${site.name}.`}>
  <div class="skills-realm">
    <Panel class="page-hero skills-hero">
      <p class="panel-jp">術式</p>
      <p class="panel-kicker">Skills</p>
      <h1>The grimoire.</h1>
      <p class="lede">
        A living index of frontend, game worlds, backend, data, and craft.
      </p>
    </Panel>

    <Panel class="skills-sky-panel">
      <div class="skills-sky">
        <div class="skills-sky__fx" aria-hidden="true">
          {
            skySparkles.map((sparkle) => (
              <span
                class="sparkle"
                style={`left:${sparkle.left};top:${sparkle.top};--size:${sparkle.size};--dur:${sparkle.duration};--delay:${sparkle.delay}`}
              />
            ))
          }
          <span class="bokeh" style="left:28%;top:22%;--size:26px;--dur:14s;--delay:0s;--drift:16px"></span>
          <span class="bokeh" style="left:68%;top:62%;--size:22px;--dur:16s;--delay:1.2s;--drift:-14px"></span>
        </div>

        <span class="skills-sky__aura" aria-hidden="true"></span>

        <svg class="skills-sky__lines" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="skills-sky__orbit" cx="50" cy="50" r="38"></circle>
          <circle class="skills-sky__orbit skills-sky__orbit--inner" cx="50" cy="50" r="22"></circle>
          <circle class="skills-sky__comet" cx="50" cy="50" r="38"></circle>
          <circle class="skills-sky__comet skills-sky__comet--inner" cx="50" cy="50" r="22"></circle>
          <g class="skills-sky__ticks">
            {
              skyTicks.map((tick) => (
                <line
                  class:list={["skills-sky__tick", tick.major && "is-major"]}
                  x1={tick.x1}
                  y1={tick.y1}
                  x2={tick.x2}
                  y2={tick.y2}
                />
              ))
            }
          </g>
        </svg>

        <div class="skills-sky__wheel">
          <svg class="skills-sky__lines" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            {
              constellation.map((node) => {
                const next = constellation[node.next];
                return (
                  <>
                    <line
                      class="skills-sky__chord"
                      x1={node.x.toFixed(2)}
                      y1={node.y.toFixed(2)}
                      x2={next.x.toFixed(2)}
                      y2={next.y.toFixed(2)}
                      style={`--delay:${0.45 + node.index * 0.08}s`}
                    />
                    <line
                      class="skills-sky__ray"
                      x1="50"
                      y1="50"
                      x2={node.x.toFixed(2)}
                      y2={node.y.toFixed(2)}
                      style={`--delay:${0.15 + node.index * 0.1}s;--skill-color:${node.skill.color}`}
                    />
                    <line
                      class="skills-sky__flow"
                      x1="50"
                      y1="50"
                      x2={node.x.toFixed(2)}
                      y2={node.y.toFixed(2)}
                      style={`--delay:${0.8 + node.index * 0.18}s;--skill-color:${node.skill.color}`}
                    />
                  </>
                );
              })
            }
          </svg>

          {
            constellation.map((node) => (
              <a
                class="skill-star"
                href={`#skill-${skillSlug(node.skill.name)}`}
                aria-label={node.skill.name}
                style={`left:${node.x}%;top:${node.y}%;--skill-color:${node.skill.color};--delay:${0.35 + node.index * 0.1}s`}
              >
                <span class="skill-star__face">
                  <span class="skill-star__glow"></span>
                  <img
                    class:list={[node.skill.invertOnDark && "invert-on-dark"]}
                    data-plate={node.skill.plate}
                    src={node.skill.icon}
                    alt=""
                    width="22"
                    height="22"
                  />
                  <b>{node.skill.short ?? node.skill.name}</b>
                </span>
              </a>
            ))
          }
        </div>

        <div class="skills-sky__seal">
          <span class="skills-sky__halo" aria-hidden="true"></span>
          <span class="skills-sky__halo skills-sky__halo--inner" aria-hidden="true"></span>
          <span class="skills-sky__jp">技</span>
          <span class="skills-sky__count">{skills.length}</span>
          <span class="skills-sky__label">arts</span>
        </div>
      </div>
    </Panel>

    <div class="skill-runes" role="tablist" aria-label="Skill schools">
      <button class="skill-rune is-active" type="button" data-filter="all" aria-pressed="true">
        All
        <small>{skills.length}</small>
      </button>
      <button class="skill-rune" type="button" data-filter="stacks" aria-pressed="false">
        Stacks
        <small>{boundPacts.length}</small>
      </button>
      {
        chapters.map(({ school, entries }) => (
          <button class="skill-rune" type="button" data-filter={school.id} aria-pressed="false">
            {school.kicker}
            <small>{entries.length}</small>
          </button>
        ))
      }
    </div>

    <section class="skill-chapter is-inview" data-category="stacks" id="stacks">
      <Panel class="skill-chapter__head">
        <div class="skill-chapter__copy">
          <p class="panel-jp">編成</p>
          <p class="panel-kicker">Stacks</p>
          <h2>Formations.</h2>
          <p class="lede">
            Named pacts — how the seals lock together into a working stack.
          </p>
        </div>
        <p class="skill-chapter__count">
          <b>{boundPacts.length}</b>
          <span>pacts</span>
        </p>
      </Panel>
      <div class="skill-pact-board">
        {boundPacts.map((pact, index) => <StackPact pact={pact} index={index} />)}
      </div>
    </section>

    {
      chapters.map(({ school, entries }, chapterIndex) => (
        <section class:list={["skill-chapter", chapterIndex === 0 && "is-inview"]} data-category={school.id}>
          <Panel class="skill-chapter__head">
            <div class="skill-chapter__copy">
              <p class="panel-jp">{school.jp}</p>
              <p class="panel-kicker">{school.kicker}</p>
              <h2>{school.label}</h2>
              <p class="lede">{school.blurb}</p>
            </div>
            <p class="skill-chapter__count">
              <b>{entries.length}</b>
              <span>{entries.length === 1 ? "art" : "arts"}</span>
            </p>
          </Panel>
          <div class="skill-lattice">
            {entries.map((skill, index) => (
              <SkillSigil skill={skill} index={index} />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <noscript>
    <style>
      .skill-sigil,
      .skill-pact {
        opacity: 1;
        transform: none;
      }
      .skill-sigil__fill {
        stroke-dashoffset: calc(100 - var(--level));
      }
    </style>
  </noscript>
</BaseLayout>

<script>
  let observer: IntersectionObserver | undefined;
  let sigilObserver: IntersectionObserver | undefined;

  function initSkills() {
    observer?.disconnect();
    sigilObserver?.disconnect();

    const runes = document.querySelectorAll<HTMLButtonElement>(".skill-rune");
    const chapters = document.querySelectorAll<HTMLElement>(".skill-chapter");
    if (!runes.length) return;

    function applyFilter(id: string) {
      runes.forEach((rune) => {
        const on = rune.dataset.filter === id;
        rune.classList.toggle("is-active", on);
        rune.setAttribute("aria-pressed", String(on));
      });

      chapters.forEach((chapter) => {
        const show = id === "all" || chapter.dataset.category === id;
        chapter.hidden = !show;
        chapter.classList.toggle("is-hidden", !show);
        if (show) chapter.classList.add("is-inview");
      });

      watchSigils();
    }

    runes.forEach((rune) => {
      rune.addEventListener("click", () => applyFilter(rune.dataset.filter ?? "all"));
    });

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-inview");
            observer?.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.05, rootMargin: "0px 0px -40px 0px" },
    );

    chapters.forEach((node) => observer?.observe(node));

    sigilObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-lit");
          playSkillProgress(entry.target as HTMLElement);
          sigilObserver?.unobserve(entry.target);
        }
      },
      { threshold: 0.2, rootMargin: "0px 0px -4% 0px" },
    );

    function watchSigils() {
      document.querySelectorAll<HTMLElement>(".skill-sigil:not(.is-lit)").forEach((node) => {
        if (node.closest("[hidden]")) return;
        sigilObserver?.observe(node);
      });
    }

    watchSigils();
  }

  function playSkillProgress(node: HTMLElement) {
    const label = node.querySelector<HTMLElement>(".skill-sigil__pct");
    const ring = node.querySelector<SVGCircleElement>(".skill-sigil__fill");
    const level = Number.parseFloat(getComputedStyle(node).getPropertyValue("--level"));
    if (!ring || !Number.isFinite(level)) return;

    const paint = (shown: number) => {
      ring.style.strokeDashoffset = String(100 - shown);
      if (label) label.textContent = `${Math.round(shown)}%`;
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      paint(level);
      return;
    }

    paint(0);
    const delay = (Number.parseFloat(getComputedStyle(node).getPropertyValue("--delay")) || 0) + 0.15;
    window.setTimeout(() => {
      const start = performance.now();
      const duration = 1400;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - (1 - t) ** 3;
        paint(level * eased);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, delay * 1000);
  }

  document.addEventListener("astro:page-load", initSkills);
</script>
