---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import StackPact from "../components/StackPact.astro";
import SkillSigil from "../components/SkillSigil.astro";
import { boundPacts } from "../data/stacks";
import { site } from "../data/site";
import {
  featuredSkills,
  groupedSkills,
  skillSchools,
  skillSlug,
  skills,
  skillsInSchool,
} from "../data/skills";
import "../styles/skills.css";

const skySparkles = [
  { left: "8%", top: "18%", size: "7px", duration: "2.4s", delay: "0.1s" },
  { left: "22%", top: "8%", size: "10px", duration: "2.8s", delay: "0.6s" },
  { left: "78%", top: "12%", size: "6px", duration: "2.1s", delay: "1.1s" },
  { left: "91%", top: "38%", size: "8px", duration: "2.6s", delay: "0.3s" },
  { left: "14%", top: "72%", size: "9px", duration: "2.9s", delay: "1.7s" },
  { left: "86%", top: "78%", size: "7px", duration: "2.5s", delay: "0.4s" },
  { left: "48%", top: "6%", size: "5px", duration: "2.2s", delay: "1.4s" },
  { left: "52%", top: "92%", size: "6px", duration: "2.7s", delay: "0.8s" },
];

const skySkills = featuredSkills.slice(0, 8);
const constellation = skySkills.map((skill, index) => {
  const angle = (index / skySkills.length) * Math.PI * 2 - Math.PI / 2;
  const radius = 38;
  const x = 50 + Math.cos(angle) * radius;
  const y = 50 + Math.sin(angle) * radius;
  return { skill, x, y, index };
});

const chapters = skillSchools
  .map((school) => ({ school, entries: skillsInSchool(school.id) }))
  .filter((chapter) => chapter.entries.length > 0);
---

<BaseLayout title="Skills" description={`The craft index of ${site.name}.`}>
  <div class="skills-realm">
    <Panel class="page-hero skills-hero">
      <p class="panel-jp">術式</p>
      <p class="panel-kicker">Skills</p>
      <h1>The grimoire.</h1>
      <p class="lede">
        A living index of frontend, game worlds, backend, data, and craft.
      </p>
    </Panel>

    <Panel class="skills-sky-panel">
      <div class="skills-sky">
        <div class="skills-sky__fx" aria-hidden="true">
          {
            skySparkles.map((sparkle) => (
              <span
                class="sparkle"
                style={`left:${sparkle.left};top:${sparkle.top};--size:${sparkle.size};--dur:${sparkle.duration};--delay:${sparkle.delay}`}
              />
            ))
          }
          <span class="bokeh" style="left:28%;top:22%;--size:26px;--dur:14s;--delay:0s;--drift:16px"></span>
          <span class="bokeh" style="left:68%;top:62%;--size:22px;--dur:16s;--delay:1.2s;--drift:-14px"></span>
        </div>

        <svg class="skills-sky__lines" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="skills-sky__orbit" cx="50" cy="50" r="38"></circle>
          <circle class="skills-sky__orbit skills-sky__orbit--inner" cx="50" cy="50" r="22"></circle>
          {
            constellation.map((node) => (
              <line
                class="skills-sky__ray"
                x1="50"
                y1="50"
                x2={node.x.toFixed(2)}
                y2={node.y.toFixed(2)}
                style={`--delay:${0.2 + node.index * 0.12}s`}
              />
            ))
          }
        </svg>

        <div class="skills-sky__seal">
          <span class="skills-sky__jp">技</span>
          <span class="skills-sky__count">{skills.length}</span>
          <span class="skills-sky__label">arts</span>
        </div>

        {
          constellation.map((node) => (
            <a
              class="skill-star"
              href={`#skill-${skillSlug(node.skill.name)}`}
              aria-label={node.skill.name}
              style={`left:${node.x}%;top:${node.y}%;--skill-color:${node.skill.color};--delay:${0.35 + node.index * 0.1}s`}
            >
              <span class="skill-star__glow"></span>
              <img
                class:list={[node.skill.invertOnDark && "invert-on-dark"]}
                data-plate={node.skill.plate}
                src={node.skill.icon}
                alt=""
                width="22"
                height="22"
              />
              <b>{node.skill.short ?? node.skill.name}</b>
            </a>
          ))
        }
      </div>
    </Panel>

    <div class="skill-runes" role="tablist" aria-label="Skill schools">
      <button class="skill-rune is-active" type="button" data-filter="all" aria-pressed="true">
        All
        <small>{skills.length}</small>
      </button>
      <button class="skill-rune" type="button" data-filter="stacks" aria-pressed="false">
        Stacks
        <small>{boundPacts.length}</small>
      </button>
      {
        chapters.map(({ school, entries }) => (
          <button class="skill-rune" type="button" data-filter={school.id} aria-pressed="false">
            {school.kicker}
            <small>{entries.length}</small>
          </button>
        ))
      }
    </div>

    <section class="skill-chapter is-inview" data-category="stacks" id="stacks">
      <Panel class="skill-chapter__head">
        <div class="skill-chapter__copy">
          <p class="panel-jp">編成</p>
          <p class="panel-kicker">Stacks</p>
          <h2>Formations.</h2>
          <p class="lede">
            Named pacts — how the seals lock together into a working stack.
          </p>
        </div>
        <p class="skill-chapter__count">
          <b>{boundPacts.length}</b>
          <span>pacts</span>
        </p>
      </Panel>
      <div class="skill-pact-board">
        {boundPacts.map((pact, index) => <StackPact pact={pact} index={index} />)}
      </div>
    </section>

    {
      chapters.map(({ school, entries }, chapterIndex) => (
        <section class:list={["skill-chapter", chapterIndex === 0 && "is-inview"]} data-category={school.id}>
          <Panel class="skill-chapter__head">
            <div class="skill-chapter__copy">
              <p class="panel-jp">{school.jp}</p>
              <p class="panel-kicker">{school.kicker}</p>
              <h2>{school.label}</h2>
              <p class="lede">{school.blurb}</p>
            </div>
            <p class="skill-chapter__count">
              <b>{entries.length}</b>
              <span>{entries.length === 1 ? "art" : "arts"}</span>
            </p>
          </Panel>
          <div class="skill-chapter__lanes">
            {
              groupedSkills(entries).map((lane) => (
                <div class="skill-lane">
                  <h3 class="skill-lane__title">{lane.name}</h3>
                  <div class="skill-lattice">
                    {lane.entries.map((skill, index) => (
                      <SkillSigil skill={skill} index={index} />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      ))
    }
  </div>

  <noscript>
    <style>
      .skill-sigil,
      .skill-pact {
        opacity: 1;
        transform: none;
      }
      .skill-sigil__fill {
        stroke-dashoffset: calc(var(--ring) - (var(--ring) * var(--level) / 100));
      }
    </style>
  </noscript>
</BaseLayout>

<script>
  const runes = document.querySelectorAll<HTMLButtonElement>(".skill-rune");
  const chapters = document.querySelectorAll<HTMLElement>(".skill-chapter");

  function applyFilter(id: string) {
    runes.forEach((rune) => {
      const on = rune.dataset.filter === id;
      rune.classList.toggle("is-active", on);
      rune.setAttribute("aria-pressed", String(on));
    });

    chapters.forEach((chapter) => {
      const show = id === "all" || chapter.dataset.category === id;
      chapter.hidden = !show;
      chapter.classList.toggle("is-hidden", !show);
      if (show) chapter.classList.add("is-inview");
    });
  }

  runes.forEach((rune) => {
    rune.addEventListener("click", () => applyFilter(rune.dataset.filter ?? "all"));
  });

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-inview");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.05, rootMargin: "0px 0px -40px 0px" },
  );

  document.querySelectorAll(".skill-chapter").forEach((node) => observer.observe(node));
</script>
