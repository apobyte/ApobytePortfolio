---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import { experience } from "../data/experience";
import { site } from "../data/site";
import { skills } from "../data/skills";

const featuredSkills = skills.slice(0, 6);

const heroSparkles = [
  { left: "12%", top: "18%", size: "7px", duration: "2.4s", delay: "0.1s" },
  { left: "22%", top: "8%", size: "10px", duration: "2.8s", delay: "0.6s" },
  { left: "38%", top: "14%", size: "6px", duration: "2.1s", delay: "1.1s" },
  { left: "58%", top: "7%", size: "11px", duration: "3.1s", delay: "0.3s" },
  { left: "74%", top: "16%", size: "8px", duration: "2.6s", delay: "1.4s" },
  { left: "86%", top: "28%", size: "6px", duration: "2.2s", delay: "0.8s" },
  { left: "18%", top: "42%", size: "9px", duration: "2.9s", delay: "1.7s" },
  { left: "81%", top: "48%", size: "7px", duration: "2.5s", delay: "0.4s" },
  { left: "8%", top: "62%", size: "6px", duration: "2.3s", delay: "1.2s" },
  { left: "91%", top: "66%", size: "8px", duration: "2.7s", delay: "0.9s" },
  { left: "46%", top: "22%", size: "12px", duration: "3.2s", delay: "0.2s" },
  { left: "64%", top: "36%", size: "5px", duration: "2s", delay: "1.6s" },
];

const heroBokeh = [
  { left: "28%", top: "10%", size: "22px", duration: "13s", delay: "0s", drift: "16px" },
  { left: "70%", top: "12%", size: "28px", duration: "16s", delay: "1.2s", drift: "-14px" },
  { left: "48%", top: "6%", size: "18px", duration: "12s", delay: "0.6s", drift: "10px" },
  { left: "14%", top: "30%", size: "16px", duration: "15s", delay: "2s", drift: "-12px" },
];
---

<BaseLayout home>
  <Panel class="skills-panel" as="aside">
    <div class="panel-head">
      <p class="panel-kicker">Skills</p>
      <p class="panel-jp">スキルセット</p>
    </div>
    <div class="skill-list">
      {
        featuredSkills.map((skill) => (
          <div class="skill">
            <img
              class:list={["skill-icon", skill.invertOnDark && "invert-on-dark"]}
              src={skill.icon}
              alt=""
              width="18"
              height="18"
            />
            <span class="skill-name">{skill.name}</span>
            <span class="skill-pct">{skill.level}%</span>
            <div class="skill-bar" aria-hidden="true">
              <span style={`--level:${skill.level}%`}></span>
            </div>
          </div>
        ))
      }
    </div>
    <a class="button button-line" href="/about#skills">View all skills →</a>
  </Panel>

  <Panel class="hero-panel">
    <div class="hero-fx" aria-hidden="true">
      {
        heroSparkles.map((sparkle) => (
          <span
            class="sparkle"
            style={`left:${sparkle.left};top:${sparkle.top};--size:${sparkle.size};--dur:${sparkle.duration};--delay:${sparkle.delay}`}
          />
        ))
      }
      {
        heroBokeh.map((orb) => (
          <span
            class="bokeh"
            style={`left:${orb.left};top:${orb.top};--size:${orb.size};--dur:${orb.duration};--delay:${orb.delay};--drift:${orb.drift}`}
          />
        ))
      }
      <span class="sakura__petal" style="left:16%;top:-8%;--dur:14s;--delay:0.4s;--drift:28px;--size:9px"></span>
      <span class="sakura__petal" style="left:62%;top:-10%;--dur:16s;--delay:2.1s;--drift:-24px;--size:11px"></span>
      <span class="sakura__petal" style="left:84%;top:8%;--dur:13s;--delay:1.2s;--drift:18px;--size:8px"></span>
      <span class="glint" style="left:34%;top:12%;--size:3px;--dur:2.1s;--delay:0.2s"></span>
      <span class="glint" style="left:52%;top:9%;--size:4px;--dur:2.4s;--delay:0.8s"></span>
      <span class="glint" style="left:71%;top:20%;--size:3px;--dur:1.9s;--delay:1.3s"></span>
      <span class="glint" style="left:41%;top:28%;--size:2px;--dur:2.6s;--delay:0.5s"></span>
    </div>
    <p class="hero-jp-vert">ようこそ</p>
    <div class="hero-copy">
      <p class="hero-hello">{site.greeting}</p>
      <h1 class="hero-name">{site.name}</h1>
      <p class="hero-role">{site.role}</p>
      <p class="hero-bio">{site.tagline}</p>
      <a class="button button-cta" href="/projects">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <g fill="#ffd0f6" stroke="#fff6ee" stroke-width="0.6">
            <g transform="translate(12 12)">
              <ellipse cx="0" cy="-5.4" rx="3.1" ry="5.4"></ellipse>
              <ellipse cx="0" cy="-5.4" rx="3.1" ry="5.4" transform="rotate(72)"></ellipse>
              <ellipse cx="0" cy="-5.4" rx="3.1" ry="5.4" transform="rotate(144)"></ellipse>
              <ellipse cx="0" cy="-5.4" rx="3.1" ry="5.4" transform="rotate(216)"></ellipse>
              <ellipse cx="0" cy="-5.4" rx="3.1" ry="5.4" transform="rotate(288)"></ellipse>
            </g>
          </g>
          <circle cx="12" cy="12" r="2.1" fill="#efd18a"></circle>
        </svg>
        Explore my work
      </a>
    </div>
    <div class="scroll-hint">
      <span class="mouse"><i></i></span>
      Scroll
    </div>
  </Panel>

  <Panel class="experience-panel" as="aside">
    <div class="panel-head">
      <p class="panel-kicker">Experience</p>
      <span class="panel-head__aside">
        <p class="panel-jp">経験</p>
        <svg class="panel-head__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M3.1 4.2h17.8v1.5H3.1zm-1 2.7h19.8v1.35H2.1zM6.2 8.4h1.7V20H6.2zm9.9 0h1.7V20h-1.7zM3.4 20h17.2v1.5H3.4z"
          />
        </svg>
      </span>
    </div>
    <div class="timeline">
      {
        experience.map((item) => (
          <article class="timeline-item">
            <p class="timeline-period">{item.period}</p>
            <h2 class="timeline-title">{item.title}</h2>
            <p class="timeline-company">{item.company}</p>
            <p class="timeline-summary">{item.summary}</p>
          </article>
        ))
      }
    </div>
    <a class="button button-line" href="/about#experience">View full journey →</a>
  </Panel>
</BaseLayout>
