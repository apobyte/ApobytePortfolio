---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import { experience } from "../data/experience";
import { site } from "../data/site";
import { skills } from "../data/skills";
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <Panel class="page-hero">
    <p class="panel-jp">自己紹介</p>
    <p class="panel-kicker">About</p>
    <h1>Building at the edge of code and atmosphere.</h1>
    <div class="prose">
      <p>
        I’m {site.name}, a {site.role.toLowerCase()} who cares about the feel of a
        product as much as the architecture behind it. Clean systems, cinematic
        interfaces, and work that still looks intentional at 2x zoom.
      </p>
      <p>{site.tagline}</p>
    </div>
  </Panel>

  <Panel class="section">
    <div class="section-head">
      <div>
        <p class="panel-kicker">Skills</p>
        <p class="panel-jp">スキルセット</p>
      </div>
    </div>
    <p class="lede">
      {skills.length} arts across frontend, game worlds, backend, data, and craft
      — each with its own seal and measure.
    </p>
    <div class="actions">
      <a class="button button-cta" href="/skills">Open the grimoire</a>
    </div>
  </Panel>

  <Panel class="section" id="experience">
    <div class="section-head">
      <div>
        <p class="panel-kicker">Experience</p>
        <p class="panel-jp">経験</p>
      </div>
    </div>
    <div class="timeline timeline--full">
      {
        experience.map((item) => (
          <article class="timeline-item">
            <p class="timeline-period">{item.period}</p>
            <h2 class="timeline-title">{item.title}</h2>
            <p class="timeline-company">
              {item.company}
              {item.location ? ` · ${item.location}` : ""}
            </p>
            <div class="timeline-body">
              {item.details.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            {item.highlights.length > 0 && (
              <div class="timeline-highlights">
                <p class="timeline-highlights__label">Key achievements</p>
                <ul>
                  {item.highlights.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </Panel>
</BaseLayout>
