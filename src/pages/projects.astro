---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" description="Selected projects and experiments.">
  <Panel class="page-hero">
    <p class="panel-jp">作品</p>
    <p class="panel-kicker">Projects</p>
    <h1>Selected work.</h1>
    <p class="lede">
      A few things shipped in public. Update the list in <code>src/data/projects.ts</code>.
    </p>
  </Panel>

  <div class="grid">
    {
      projects.map((project) => (
        <a class="panel card" href={project.href}>
          <span class="panel__corners" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
          <div class="meta">
            <span>{project.year}</span>
            <span>Project</span>
          </div>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
