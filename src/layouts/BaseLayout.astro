---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import SakuraPetals from "../components/SakuraPetals.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/skills.css";

type Props = {
  title?: string;
  description?: string;
  home?: boolean;
  projects?: boolean;
};

const { title, description = site.tagline, home = false, projects = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
---

<!doctype html>
<html lang="en" class="is-anime-loading" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font
      cssVariable="--font-outfit"
      preload={[
        { weight: 400, style: "normal", subset: "latin" },
        { weight: 600, style: "normal", subset: "latin" },
        { weight: 700, style: "normal", subset: "latin" },
      ]}
    />
    <Font cssVariable="--font-kaushan" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-yuji" />
    <Font cssVariable="--font-zen-kaku" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-zen-maru" preload={[{ weight: 700, style: "normal" }]} />
    <Font cssVariable="--font-dela" preload />
    {home && <link rel="preload" as="image" href="/images/hero.png" />}
    {home && <link rel="preload" as="image" href="/images/dashboard-light.jpg" />}
    {projects && <link rel="preload" as="image" href="/images/projects-hero.jpg" />}
    {projects && <link rel="preload" as="image" href="/images/projects-light.jpg" />}
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem("theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
        if (window.__apoleoBooted) {
          document.documentElement.classList.remove("is-anime-loading");
        }
      }

      applyTheme();
      if (!window.__apoleoThemeBound) {
        window.__apoleoThemeBound = true;
        document.addEventListener("astro:after-swap", applyTheme);
      }
    </script>
  </head>
  <body class:list={[home && "is-home", projects && "is-projects"]}>
    <LoadingScreen />
    <SakuraPetals />
    <Header />
    <main id="content" class:list={[home ? "page-home" : "page-inner"]} transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
